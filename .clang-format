---
BasedOnStyle: LLVM
Standard: Latest
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
PointerAlignment: Left
NamespaceIndentation: None
FixNamespaceComments: true
SpacesBeforeTrailingComments: 2
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Kolejność nagłówków ma znaczenie: <cppin/in.hpp> definiuje makro `in`,
# więc musi być dołączany po nagłówkach biblioteki standardowej.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[a-z_]+>$'      # biblioteka standardowa
    Priority: 1
  - Regex: '^<doctest/'
    Priority: 2
  - Regex: '^<cppin/'
    Priority: 3
  - Regex: '^"'               # lokalne nagłówki testów (dołączają cppin)
    Priority: 4
...
